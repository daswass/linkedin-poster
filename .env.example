# LinkedIn API Credentials Template
# Copy this file to .env and fill in your actual credentials

LINKEDIN_CLIENT_ID=your_client_id_here
LINKEDIN_CLIENT_SECRET=your_client_secret_here
LINKEDIN_ACCESS_TOKEN=your_access_token_here
# Optional: returned only when LinkedIn enables programmatic refresh tokens for the app
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_ACCESS_TOKEN_EXPIRES_IN=
LINKEDIN_REFRESH_TOKEN_EXPIRES_IN=
LINKEDIN_GRANTED_SCOPE=
LINKEDIN_TOKEN_REFRESHED_AT=
LINKEDIN_COMPANY_PAGE_URN=urn:li:organization:your_page_id_here

# Gemini API for image generation
GEMINI_API_KEY=your_gemini_api_key_here

# Google Business Profile cross-poster. Keep actual values in
# ~/.openclaw/secrets/.env.linkedin-poster, never in this repository.
# Preferred authorization: gcloud auth application-default login --scopes=https://www.googleapis.com/auth/cloud-platform,https://www.googleapis.com/auth/business.manage
# Alternatively, create OAuth credentials with the Google Business Profile API
# enabled, then authorize the Google account that manages the target location.
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_REFRESH_TOKEN=
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=
GOOGLE_BUSINESS_CTA_URL=https://your-domain.example
GOOGLE_BUSINESS_CTA_TYPE=LEARN_MORE
# Safety watermark: only LinkedIn publications on/after this UTC time are eligible.
GOOGLE_BUSINESS_CROSSPOST_START_AT=2026-10-25T00:00:00Z
